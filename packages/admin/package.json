{
  "name": "@tvine/admin",
  "version": "0.0.0",
  "description": "Tvine admin panel UI: Django-style admin with dashboard, charts and system pages.",
  "keywords": [
    "agent-native",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "webmcp",
    "django",
    "typescript",
    "nextjs",
    "react",
    "orm",
    "admin-panel",
    "web-framework",
    "full-stack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zohaib3249/tvine.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/zohaib3249/tvine#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./admin.css": "./dist/admin.css",
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "scripts": {
    "build": "tsc -p . && tailwindcss -i src/admin.css -o dist/admin.css --minify && esbuild dist/client.js --bundle --minify --format=esm --platform=browser --define:process.env.NODE_ENV='\"production\"' --alias:server-only=../weft/node_modules/server-only/empty.js --outfile=dist/static/admin.js --log-level=warning",
    "test": "vitest run"
  },
  "dependencies": {
    "@tvine/weft": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.14",
    "tailwindcss": "4.1.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "esbuild": "0.28.2"
  }
}
