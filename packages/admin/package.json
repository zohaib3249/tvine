{
  "name": "@tvine/admin",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./page": { "types": "./dist/page.d.ts", "default": "./dist/page.js" },
    "./layout": { "types": "./dist/layout.d.ts", "default": "./dist/layout.js" },
    "./admin.css": "./dist/admin.css"
  },
  "scripts": {
    "build": "tsc -p . && tailwindcss -i src/admin.css -o dist/admin.css --minify",
    "test": "vitest run"
  },
  "dependencies": {
    "@tvine/weft": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.14",
    "tailwindcss": "4.1.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
