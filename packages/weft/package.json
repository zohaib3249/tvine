{
  "name": "@tvine/weft",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/universal.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/universal.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./api": {
      "react-server": {
        "types": "./dist/api/server.d.ts",
        "default": "./dist/api/server.js"
      },
      "types": "./dist/api/client.d.ts",
      "default": "./dist/api/client.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js",
      "default": "./dist/widgets/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js",
      "default": "./dist/forms/index.js"
    },
    "./forms/forms.css": "./dist/forms/forms.css",
    "./dev": {
      "types": "./dist/dev/Gallery.d.ts",
      "default": "./dist/dev/Gallery.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p . && cp src/forms/forms.css dist/forms/forms.css",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "server-only": "^0.0.1",
    "@tvine/warp": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3.25.76"
  }
}
