{
  "name": "tvinejs",
  "version": "0.2.0",
  "description": "Tvine: agent-native full-stack web framework. Django-style TypeScript backend (ORM, migrations, auth, admin, tasks, built-in MCP server) + Next.js/React frontend that AI agents can read and drive.",
  "keywords": [
    "agent-native",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "webmcp",
    "django",
    "typescript",
    "nextjs",
    "react",
    "orm",
    "migrations",
    "admin",
    "admin-panel",
    "web-framework",
    "full-stack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zohaib3249/tvine.git"
  },
  "homepage": "https://github.com/zohaib3249/tvine#readme",
  "bugs": "https://github.com/zohaib3249/tvine/issues",
  "type": "module",
  "main": "warp/dist/index.js",
  "types": "warp/dist/index.d.ts",
  "bin": {
    "tvine": "warp/bin/tvine.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "AGENTS.md",
    "warp/bin",
    "warp/data",
    "warp/dist",
    "weft/dist",
    "admin/dist",
    "inspect/dist",
    "inspect/static",
    "!**/*.map",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./warp/dist/index.d.ts",
      "import": "./warp/dist/index.js"
    },
    "./auth": {
      "types": "./warp/dist/contrib/auth/index.d.ts",
      "import": "./warp/dist/contrib/auth/index.js"
    },
    "./migrations": {
      "types": "./warp/dist/data/migrations.d.ts",
      "import": "./warp/dist/data/migrations.js"
    },
    "./testing": {
      "types": "./warp/dist/testing.d.ts",
      "import": "./warp/dist/testing.js"
    },
    "./shape": {
      "types": "./warp/dist/shape/index.d.ts",
      "import": "./warp/dist/shape/index.js"
    },
    "./types": {
      "types": "./warp/dist/types/api.d.ts",
      "import": "./warp/dist/types/api.js"
    },
    "./tasks": {
      "types": "./warp/dist/contrib/tasks/index.d.ts",
      "import": "./warp/dist/contrib/tasks/index.js"
    },
    "./cli": {
      "types": "./warp/dist/cli.d.ts",
      "import": "./warp/dist/cli.js"
    },
    "./contrib/admin": {
      "types": "./warp/dist/contrib/admin/index.d.ts",
      "import": "./warp/dist/contrib/admin/index.js"
    },
    "./contrib/*": {
      "types": "./warp/dist/contrib/*.d.ts",
      "import": "./warp/dist/contrib/*.js"
    },
    "./weft": {
      "react-server": {
        "types": "./weft/dist/server.d.ts",
        "default": "./weft/dist/server.js"
      },
      "types": "./weft/dist/universal.d.ts",
      "default": "./weft/dist/index.js"
    },
    "./weft/server": {
      "types": "./weft/dist/server.d.ts",
      "default": "./weft/dist/server.js"
    },
    "./weft/dev": {
      "types": "./weft/dist/dev/Gallery.d.ts",
      "default": "./weft/dist/dev/Gallery.js"
    },
    "./weft/jsx-runtime": {
      "types": "./weft/dist/jsx/jsx-runtime.d.ts",
      "default": "./weft/dist/jsx/jsx-runtime.js"
    },
    "./weft/jsx-dev-runtime": {
      "types": "./weft/dist/jsx/jsx-dev-runtime.d.ts",
      "default": "./weft/dist/jsx/jsx-dev-runtime.js"
    },
    "./api": {
      "react-server": {
        "types": "./weft/dist/api/server.d.ts",
        "default": "./weft/dist/api/server.js"
      },
      "types": "./weft/dist/api/client.d.ts",
      "default": "./weft/dist/api/client.js"
    },
    "./widgets": {
      "types": "./weft/dist/widgets/index.d.ts",
      "default": "./weft/dist/widgets/index.js"
    },
    "./forms": {
      "types": "./weft/dist/forms/index.d.ts",
      "default": "./weft/dist/forms/index.js"
    },
    "./forms/forms.css": "./weft/dist/forms/forms.css",
    "./admin": {
      "types": "./admin/dist/index.d.ts",
      "default": "./admin/dist/index.js"
    },
    "./admin/page": {
      "types": "./admin/dist/page.d.ts",
      "default": "./admin/dist/page.js"
    },
    "./admin/layout": {
      "types": "./admin/dist/layout.d.ts",
      "default": "./admin/dist/layout.js"
    },
    "./admin/serve": {
      "types": "./admin/dist/serve.d.ts",
      "default": "./admin/dist/serve.js"
    },
    "./admin.css": "./admin/dist/admin.css",
    "./inspect": {
      "types": "./inspect/dist/index.d.ts",
      "default": "./inspect/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#weft/jsx-runtime": "./weft/dist/jsx/jsx-runtime.js",
    "#weft/jsx-dev-runtime": "./weft/dist/jsx/jsx-dev-runtime.js"
  },
  "scripts": {
    "build": "tsc -p inspect && tsc -p warp && tsc -p weft && cp weft/src/forms/forms.css weft/dist/forms/forms.css && tsc -p admin && tailwindcss -i admin/src/admin.css -o admin/dist/admin.css --minify && esbuild admin/dist/client.js --bundle --minify --format=esm --platform=browser --define:process.env.NODE_ENV='\"production\"' --alias:server-only=./node_modules/server-only/empty.js --outfile=admin/dist/static/admin.js --log-level=warning && tailwindcss -i admin/src/shield/shield.css -o admin/dist/shield/shield.css --minify && esbuild admin/dist/shield/client.js --bundle --minify --format=esm --platform=browser --define:process.env.NODE_ENV='\"production\"' --alias:server-only=./node_modules/server-only/empty.js --outfile=admin/dist/shield/shield.js --log-level=warning",
    "test": "for d in warp weft admin inspect; do (cd $d && vitest run --passWithNoTests) || exit 1; done",
    "test:pg": "./warp/scripts/test-pg.sh",
    "test:mysql": "./warp/scripts/test-mysql.sh",
    "test:redis": "./warp/scripts/test-redis.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "^13.0.3",
    "esbuild": "0.28.2",
    "nanoid": "^5",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19",
    "react-dom": "^19",
    "mysql2": "^3",
    "pg": "^8",
    "redis": "^6"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "mysql2": "^3",
    "pg": "^8.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "tailwindcss": "4.1.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
