{
  "name": "@tvine/warp",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tvine": "bin/tvine.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/contrib/auth/index.d.ts",
      "import": "./dist/contrib/auth/index.js"
    },
    "./migrations": {
      "types": "./dist/data/migrations.d.ts",
      "import": "./dist/data/migrations.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./shape": {
      "types": "./dist/shape/index.d.ts",
      "import": "./dist/shape/index.js"
    },
    "./types": {
      "types": "./dist/types/api.d.ts",
      "import": "./dist/types/api.js"
    },
    "./tasks": {
      "types": "./dist/contrib/tasks/index.d.ts",
      "import": "./dist/contrib/tasks/index.js"
    },
    "./contrib/*": {
      "types": "./dist/contrib/*.d.ts",
      "import": "./dist/contrib/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:pg": "./scripts/test-pg.sh",
    "test:mysql": "./scripts/test-mysql.sh",
    "test:redis": "./scripts/test-redis.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "^13.0.3",
    "esbuild": "0.28.2",
    "nanoid": "^5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8",
    "ioredis": "5.4.1",
    "mysql2": "^3",
    "pg": "^8.13.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependencies": {
    "mysql2": "^3",
    "pg": "^8",
    "ioredis": "^5"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
