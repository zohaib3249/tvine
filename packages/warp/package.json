{
  "name": "@tvine/warp",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "tvine": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/data/migrations.d.ts",
      "import": "./dist/data/migrations.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:pg": "./scripts/test-pg.sh",
    "test:mysql": "./scripts/test-mysql.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "^13.0.3",
    "nanoid": "^5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8",
    "mysql2": "^3",
    "pg": "^8.13.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependencies": {
    "pg": "^8",
    "mysql2": "^3"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  }
}
